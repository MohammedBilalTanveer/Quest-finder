# Copy to .env and adjust. All values optional.
SOURCE_URL=https://nycpokemap.com/quests.php
# Filter string the source page itself uses for Eternatus (candy reward, id 890)
SOURCE_FILTER=4,0,890
TARGET_POKEMON=Eternatus
TARGET_POKEMON_ID=890
TARGET_TASK=Make an Excellent Throw
CACHE_TTL_SECONDS=60
MIN_SOURCE_INTERVAL_SECONDS=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 to serve clearly labelled SAMPLE data (no source request). For UI testing only.
USE_SAMPLE_DATA=0
